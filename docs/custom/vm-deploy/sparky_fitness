#!/bin/bash
# sparky_fitness — shell wrapper for OpenClaw gateway exec-fallback → SparkyFitness API
# Deploy to: ~/bin/sparky_fitness  (chmod +x)
# Usage: sparky_fitness <action> [opts]
#   summary                          today macro progress
#   diary                            full food log for today
#   goals                            macro targets
#   log_water <ml>                   log water intake
#   weight [kg]                      log or read today weight
#   sleep                            read today sleep
#   log_food <name> <meal> <grams> <calories> <protein_g> <carbs_g> <fat_g>
#   delete_entry <entry_uuid>        DELETE /food-entries/:id (get id from: diary_json)
#   purge_test_foods                   remove DiagTest*/WriteTest* entries for logical today

set -euo pipefail

TOKEN=$(cat "$HOME/.openclaw/secrets/sparky-token" 2>/dev/null || true)
BASE="http://localhost:3004/api"
# Gateway VM often runs UTC; logs/summary must use the operator's calendar day (SAST by default).
# Override: export SPARKY_LOCAL_TZ=UTC (or your IANA zone).
SPARKY_LOCAL_TZ="${SPARKY_LOCAL_TZ:-Africa/Johannesburg}"
TODAY=$(TZ="$SPARKY_LOCAL_TZ" date +%Y-%m-%d)
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

if [ -z "$TOKEN" ]; then
  echo "ERROR: SparkyFitness token not found at ~/.openclaw/secrets/sparky-token"
  exit 1
fi

_get()  { curl -sf -H "x-api-key: $TOKEN" "$BASE$1" -o "$TMP"; }
_post() { curl -sf -X POST -H "x-api-key: $TOKEN" -H "Content-Type: application/json" -d "$2" "$BASE$1" -o "$TMP"; }
_delete() { curl -sf -X DELETE -H "x-api-key: $TOKEN" "$BASE$1" -o "$TMP"; }

ACTION="${1:-summary}"

case "$ACTION" in

  summary)
    _get "/dashboard/stats?date=$TODAY" 2>/dev/null || echo "{}" > "$TMP"
    STATS=$(cat "$TMP")
    _get "/goals/by-date/$TODAY" 2>/dev/null || echo "{}" > "$TMP"
    GOALS=$(cat "$TMP")
    _get "/measurements/water-intake/$TODAY" 2>/dev/null || echo "{}" > "$TMP"
    WATER=$(cat "$TMP")
    _get "/food-entries?selectedDate=$TODAY" 2>/dev/null || echo "[]" > "$TMP"
    ENTRIES=$(cat "$TMP")
    python3 -c "
import json, sys
stats = json.loads(sys.argv[1])
goals = json.loads(sys.argv[2])
water_data = json.loads(sys.argv[3])
raw = json.loads(sys.argv[4])
entries = raw if isinstance(raw, list) else [raw]
entries = [e for e in entries if isinstance(e, dict) and e]
sum_cal = sum(float(e.get('calories') or 0) for e in entries)
sum_prot = sum(float(e.get('protein') or 0) for e in entries)
sum_carb = sum(float(e.get('carbs') or 0) for e in entries)
sum_fat = sum(float(e.get('fat') or 0) for e in entries)
# /dashboard/stats has reliable eaten kcal but (currently) no macro totals — sum macros from food-entries.
eaten = stats.get('eaten')
cal = float(eaten) if eaten is not None else sum_cal
if cal == 0 and sum_cal:
    cal = sum_cal
prot, carb, fat = sum_prot, sum_carb, sum_fat
water = water_data.get('water_ml') or 0
gcal  = goals.get('calories') or 0
gprot = goals.get('protein')  or 0
gcarb = goals.get('carbs')    or 0
gfat  = goals.get('fat')      or 0
gwater = goals.get('water_goal_ml') or 0
print(f'Macros for $TODAY:')
print(f'  Calories: {float(cal):.0f} / {float(gcal):.0f} kcal')
print(f'  Protein:  {float(prot):.1f} / {float(gprot):.1f}g')
print(f'  Carbs:    {float(carb):.1f} / {float(gcarb):.1f}g')
print(f'  Fat:      {float(fat):.1f} / {float(gfat):.1f}g')
print(f'  Water:    {float(water):.0f} / {float(gwater):.0f} ml')
" "$STATS" "$GOALS" "$WATER" "$ENTRIES"
    ;;

  diary)
    _get "/food-entries?selectedDate=$TODAY"
    python3 -c "
import json
entries = json.load(open('$TMP'))
if not entries:
    print('No food entries for $TODAY.')
else:
    for e in (entries if isinstance(entries, list) else [entries]):
        name = e.get('food_name') or e.get('name','?')
        meal = e.get('meal_type','?')
        cal  = e.get('calories') or 0
        print(f'  [{meal}] {name} — {float(cal):.0f} kcal')
"
    ;;

  goals)
    _get "/goals/by-date/$TODAY"
    python3 -c "
import json
g = json.load(open('$TMP'))
print('Macro goals:')
print(f'  Calories: {float(g.get(\"calories\",0)):.0f} kcal')
print(f'  Protein:  {float(g.get(\"protein\",0)):.1f}g')
print(f'  Carbs:    {float(g.get(\"carbs\",0)):.1f}g')
print(f'  Fat:      {float(g.get(\"fat\",0)):.1f}g')
"
    ;;

  log_water)
    ML="${2:-250}"
    DRINKS=$(python3 -c "print(max(1, round($ML / 250)))")
    _post "/measurements/water-intake" "{\"entry_date\":\"$TODAY\",\"change_drinks\":$DRINKS,\"container_id\":null}"
    echo "Logged ${ML}ml (~${DRINKS} drinks) water for $TODAY."
    ;;

  weight)
    if [ -n "${2:-}" ]; then
      _post "/measurements/check-in" "{\"entry_date\":\"$TODAY\",\"weight\":$2}"
      echo "Logged weight $2 kg for $TODAY."
    else
      _get "/measurements/check-in/$TODAY"
      python3 -c "
import json
d = json.load(open('$TMP'))
w = d.get('weight') or d.get('weight_kg','—')
print(f'Weight $TODAY: {w} kg')
"
    fi
    ;;

  sleep)
    _get "/sleep?startDate=$TODAY&endDate=$TODAY"
    python3 -c "
import json
records = json.load(open('$TMP'))
records = records if isinstance(records, list) else [records]
if not records or records == [{}]:
    print('No sleep data for $TODAY.')
else:
    for r in records:
        print(f'  Sleep: {r.get(\"duration_minutes\",\"?\") } min, quality {r.get(\"quality\",\"?\")}')
"
    ;;

  log_food)
    FOOD_NAME="${2:?food name required}"
    MEAL="${3:?meal required (breakfast/lunch/dinner/snack)}"
    GRAMS="${4:-100}"
    CAL="${5:-0}"
    PROT="${6:-0}"
    CARB="${7:-0}"
    FAT="${8:-0}"
    [[ "$MEAL" == "snack" ]] && MEAL="snacks"
    FOOD_BODY=$(python3 -c "import json,sys; print(json.dumps({'name':sys.argv[1],'is_custom':True,'serving_size':float(sys.argv[6]),'serving_unit':'g','calories':float(sys.argv[2]),'protein':float(sys.argv[3]),'carbs':float(sys.argv[4]),'fat':float(sys.argv[5])}))" "$FOOD_NAME" "$CAL" "$PROT" "$CARB" "$FAT" "$GRAMS")
    _post "/foods" "$FOOD_BODY"
    FOOD_ID=$(python3 -c "import json; print(json.load(open('$TMP')).get('id',''))")
    VARIANT_ID=$(python3 -c "import json; d=json.load(open('$TMP')); v=d.get('default_variant') or {}; print(v.get('id',''))")
    if [ -z "$FOOD_ID" ]; then
      echo "ERROR: Could not create food item '$FOOD_NAME'."
      exit 1
    fi
    ENTRY_BODY=$(python3 -c "import json,sys; d={'food_id':sys.argv[1],'entry_date':sys.argv[4],'meal_type':sys.argv[2],'quantity':float(sys.argv[3]),'unit':'g'}; v=sys.argv[5]; d['variant_id']=v if v else None; print(json.dumps(d))" "$FOOD_ID" "$MEAL" "$GRAMS" "$TODAY" "$VARIANT_ID")
    _post "/food-entries" "$ENTRY_BODY"
    echo "Logged ${GRAMS}g of $FOOD_NAME ($MEAL) for $TODAY."
    ;;

  delete_entry)
    EID="${2:?food entry id (uuid) required}"
    _delete "/food-entries/$EID"
    echo "Deleted food entry $EID — $(head -c 200 "$TMP" | tr -d '\n')"
    ;;

  diary_json)
    _get "/food-entries?selectedDate=$TODAY"
    cat "$TMP"
    echo ""
    ;;

  purge_test_foods)
    _get "/food-entries?selectedDate=$TODAY"
    SPARKY_TOKEN="$TOKEN" SPARKY_BASE="$BASE" python3 - "$TMP" <<'PY'
import json, os, sys, urllib.error, urllib.request

path = sys.argv[1]
token = os.environ["SPARKY_TOKEN"]
base = os.environ["SPARKY_BASE"].rstrip("/")
entries = json.load(open(path))
entries = entries if isinstance(entries, list) else [entries]
needles = ("DiagTest", "WriteTest")
removed = 0
for e in entries:
    if not isinstance(e, dict):
        continue
    name = str(e.get("food_name") or e.get("name") or "")
    if not any(n in name for n in needles):
        continue
    eid = e.get("id")
    if not eid:
        continue
    url = f"{base}/food-entries/{eid}"
    req = urllib.request.Request(url, method="DELETE", headers={"x-api-key": token})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            r.read()
        print(f"Removed {eid} ({name})")
        removed += 1
    except urllib.error.HTTPError as err:
        print(f"FAILED {eid} ({name}): HTTP {err.code}")
print(f"Total removed: {removed}")
PY
    ;;

  *)
    echo "Unknown action: $ACTION"
    echo "Usage: sparky_fitness summary|diary|diary_json|goals|log_water [ml]|weight [kg]|sleep|delete_entry <uuid>|purge_test_foods|log_food <name> <meal> <g> <kcal> <protein> <carbs> <fat>"
    exit 1
    ;;
esac
